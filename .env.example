# Copy this file to .env and fill in the values (scripts/setup.sh or scripts\setup.bat does it on a new computer).
# .env holds secrets - it is never committed. Keep a copy somewhere safe.
DATABASE_URL=postgresql+asyncpg://feedback:feedback_dev_pw@127.0.0.1:5433/feedback
# Signs the dashboard's login cookies (changing it logs everyone out). The setup generates one; by hand:
# python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# From @BotFather
BOT_TOKEN=
SUPPORT_CONTACT=@tridonus
TECH_CONTACT=@qomusiy

# The public address of the survey (README › Fixed address):
#   quick       free, but a new https://….trycloudflare.com address after every restart
#   tailscale   free, the same https://talaba-ovozi.<tailnet>.ts.net address forever
#   cloudflare  your own domain, the same address forever: also set CLOUDFLARE_TUNNEL_TOKEN and WEBAPP_URL
#   off         no public address (trying things on a computer that isn't the server)
# Empty: the setup asks. After changing it run the setup again (scripts/setup.sh or scripts\setup.bat).
TUNNEL=
CLOUDFLARE_TUNNEL_TOKEN=
# Only for TUNNEL=cloudflare: e.g. https://ovoz.example.uz (leave empty otherwise)
WEBAPP_URL=
# TUNNEL=tailscale: if its address stops answering, students get a Cloudflare quick tunnel until it is back
TUNNEL_BACKUP=true
# 0.0.0.0: the dashboard also opens at this computer's Tailscale address (http://100.x.y.z:8000/admin) - only for
# the devices of your Tailscale account; the network around it gets nothing (README › Remote access).
WEB_HOST=127.0.0.1

# DEV ONLY - opens the survey as any student on this computer. Never true on a server.
DEV_MODE=false
