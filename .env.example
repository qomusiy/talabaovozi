# Copy this file to .env and fill in the values (scripts/setup.sh does it on a new computer).
# .env holds secrets - it is never committed. Keep a copy somewhere safe.
DATABASE_URL=postgresql+asyncpg://feedback:feedback_dev_pw@127.0.0.1:5433/feedback
# Used to hash passport codes. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# NEVER change it after importing students, or nobody will be able to log in until you re-import.
SECRET_KEY=change-me
# From @BotFather
BOT_TOKEN=
SUPPORT_CONTACT=@tridonus
TECH_CONTACT=@qomusiy

# The public address of the survey (README › Fixed address):
#   quick       free, but a new https://….trycloudflare.com address after every restart
#   tailscale   free, the same https://talaba-ovozi.<tailnet>.ts.net address forever
#   cloudflare  your own domain, the same address forever: also set CLOUDFLARE_TUNNEL_TOKEN and WEBAPP_URL
# Empty: scripts/setup.sh asks. After changing it: scripts/setup.sh
TUNNEL=
CLOUDFLARE_TUNNEL_TOKEN=
# Only for TUNNEL=cloudflare: e.g. https://ovoz.example.uz (leave empty otherwise)
WEBAPP_URL=

# DEV ONLY - opens the survey as any student on this computer. Never true on a server.
DEV_MODE=false
